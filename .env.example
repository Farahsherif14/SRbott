# Template for .env. Copy it to .env and put the real values there.
# Never put real values in this file, and never commit .env (it is git-ignored).
# An empty value (KEY=) means "not set": the app then uses its default from app/config.py.

# --- LLM (Groq) ---
# Groq API key from the Groq console. A secret. The relay (groq_relay.py) sends it to Groq;
# the app only checks that it is set.
GROQ_API_KEY=your_groq_api_key
# The Groq model name, written as Groq writes it.
GROQ_MODEL=openai/gpt-oss-20b

# --- Telegram ---
# Bot token from @BotFather in Telegram. A secret: the bot stops at startup without it.
# Only one copy of a bot can run at a time, so test on your laptop with your own test bot.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# --- Databases ---
# docker-compose.yml reads these 3 to create the PostgreSQL database on its first start (empty
# volume). Changing them later does not change the existing database.
# Password: letters and digits only, because it goes inside DATABASE_URL below. Empty = compose stops.
POSTGRES_USER=srbott
POSTGRES_PASSWORD=
POSTGRES_DB=srbott
# The port on this computer: 5432, or another one (e.g. 5433) if 5432 is already taken by another
# project. DATABASE_URL below uses it automatically. Don't leave it empty: compose would use 5432,
# but the URL below would get no port.
POSTGRES_PORT=5432
# PostgreSQL URL for the new database code, built from the 4 values above (keep them above this
# line). 127.0.0.1, not localhost: on Windows, localhost may try IPv6 first. The tests use the same
# URL with "_test" added to the database name. A secret: it contains the password.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${POSTGRES_PORT:-5432}/${POSTGRES_DB}
# The old SQLite database of the current bot and API (app/db/__init__.py), until the flow moves to
# PostgreSQL. Old .env files: the bot no longer reads DATABASE_URL for SQLite, it reads this line.
LEGACY_DATABASE_URL=sqlite:///./service_requests.db
# Redis connection URL for the session memory. A secret too (it can contain a password).
REDIS_URL=redis://localhost:6379/0

# --- Speech-to-text and classifier ---
# Path to the Tawasul speech-to-text model file (.nemo).
TAWASUL_MODEL_PATH=tawasul_egy_stt.nemo
# Address of the local Ollama server; the classifier's embedding model runs there.
OLLAMA_HOST=http://localhost:11434

# --- Session memory ---
# Seconds without a new message before a chat's session is deleted (1800 = 30 minutes).
# Must be a whole number above 0, or the app stops at startup.
SESSION_TTL_SECONDS=1800
# How many recent messages (user or bot) the history keeps for the LLM. Must be a whole number
# above 0. 10 is a starting value until the token budget per LLM call is decided.
HISTORY_MAX_MESSAGES=10
